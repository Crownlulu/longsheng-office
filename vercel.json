{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/office/[...path].mjs": { "maxDuration": 150 }
  },
  "rewrites": [
    { "source": "/office", "destination": "/index.html" },
    { "source": "/office/:path*", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
